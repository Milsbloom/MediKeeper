# Copy this file to .env.local (git ignores it) and fill in the keys from RevenueCat (Project settings > API keys).
# These are public SDK keys, safe to ship in the app. Never put a secret key (sk_...) here.

# Used in Expo Go: RevenueCat Test Store key (starts with test_)
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Used in real builds
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
